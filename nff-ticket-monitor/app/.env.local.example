# Local test configuration. Copy to .env.local and fill in the Telegram values.
#
#   cp .env.local.example .env.local
#   $EDITOR .env.local
#   ../run-local.sh check
#
# Values with spaces, parentheses or JSON must stay quoted - run-local.sh
# sources this file with the shell.
#
# These mirror chart/values.yaml. They are duplicated rather than derived so
# local testing needs no yaml tooling - if you change a value in values.yaml
# and want the same behaviour locally, change it here too.

TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID
UPTIME_KUMA_PUSH_URL=

TZ=Europe/Oslo
STATE_DIR=./local-state

USER_AGENT='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36 nff-ticket-monitor/0.1 (personal ticket notifier)'
REQUEST_TIMEOUT_SECONDS=30
MIN_REQUEST_INTERVAL_SECONDS=2.0
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=5
BACKOFF_MAX_SECONDS=120

ANNOUNCE_ENABLED=true
ANNOUNCE_HOME_ONLY=true

NORMAL_INTERVAL_SECONDS=1800
RESALE_INTERVAL_SECONDS=240
HOT_INTERVAL_SECONDS=60
HOT_WINDOW_BEFORE_SECONDS=600
HOT_WINDOW_AFTER_SECONDS=3600
MAX_RUN_SECONDS=240
NOTIFY_COOLDOWN_SECONDS=600
PARSE_FAILURE_ALERT_COOLDOWN_SECONDS=21600

WATCH_JSON='[{"productId":10229739619905,"label":"Nations League - A-herrer","include":["Norge vs *"],"sources":["primary","resale"]},{"productId":10229719360412,"label":"Privatlandskamper - A-herrer","include":["Norge vs *"],"sources":["primary","resale"]}]'
